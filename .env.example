# Local development (never active in production)
LOCAL_ACCESS=true
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Exactly two approved email addresses, separated by a comma
ALLOWED_EMAILS=
HOUSEHOLD_ID=our-household

# Local SQLite. On Vercel use a remote libSQL URL and token.
DATABASE_URL=file:.data/steadier.db
DATABASE_AUTH_TOKEN=

# Optional environment defaults. You can connect/select models in Household instead.
# openrouter | groq | xai | google | compatible
AI_PROVIDER=xai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=
# Independent reader: choose Gemini from your current Google AI Studio catalog.
DOCUMENT_AI_PROVIDER=google
DOCUMENT_AI_MODEL=
AI_DOCUMENT_MODEL=
AI_JSON_MODE=true
AI_DAILY_CALL_LIMIT=40
AI_MAX_OUTPUT_TOKENS=4000

# local | s3 | vercel-blob. Vercel requires remote storage.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
