# Local development (never active in production)
LOCAL_ACCESS=true
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Exactly two approved email addresses, separated by a comma
ALLOWED_EMAILS=
HOUSEHOLD_ID=our-household

# Local SQLite. On Vercel use a remote libSQL URL and token.
DATABASE_URL=file:.data/steadier.db
DATABASE_AUTH_TOKEN=

# OpenAI-compatible adapter: OpenAI, OpenRouter, local gateways, etc.
# Choose a model that supports your input types and JSON responses.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_JSON_MODE=true
AI_DAILY_CALL_LIMIT=40
AI_MAX_OUTPUT_TOKENS=4000

# local | s3 | vercel-blob. Vercel requires remote storage.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
